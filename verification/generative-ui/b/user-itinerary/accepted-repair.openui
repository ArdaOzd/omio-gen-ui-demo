details = SplitPane("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", null, null, null, "Fare details and selection", null, [choices, summary])
root = TravelSurface("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", null, null, null, "Three-leg train and bus comparison", null, [hero, notice, comparison, details])
