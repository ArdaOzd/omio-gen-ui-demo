$filters = {"modes":[],"carrierIds":[],"directOnly":false}
$selectedFareIds = []
$show = false
modeQuery = Query("local_query", {"version":1,"sources":[{"datasetRef":"dataset-1hq3nnw","alias":"fares"}],"where":$filters.modes.length > 0 ? {"all":[{"field":"serviceDate","op":"between","value":["2026-10-09","2026-10-15"]},{"field":"mode","op":"in","value":$filters.modes}]} : {"field":"serviceDate","op":"between","value":["2026-10-09","2026-10-15"]},"project":["mode"],"groupBy":["mode"],"metrics":[{"as":"minimum","op":"min","field":"priceCents"},{"as":"fastest","op":"min","field":"durationMinutes"},{"as":"count","op":"count"}],"orderBy":[{"field":"minimum","direction":"asc"}],"limit":4})
fareQuery = Query("local_query", {"version":1,"sources":[{"datasetRef":"dataset-1hq3nnw","alias":"fares"}],"where":$filters.modes.length > 0 ? {"all":[{"field":"serviceDate","op":"between","value":["2026-10-09","2026-10-15"]},{"field":"mode","op":"in","value":$filters.modes}]} : {"field":"serviceDate","op":"between","value":["2026-10-09","2026-10-15"]},"project":["id","originId","destinationId","serviceDate","mode","carrierId","priceCents","durationMinutes","departureMinutes","availableSeats","currency","synthetic","priceBasis","direct"],"orderBy":[{"field":"priceCents","direction":"asc"}],"limit":100})
reveal = Mutation("patch_artifact_state", {"kind":"runtimeVariables","runtimeVariables":{"$show":true}})
hero = TravelHero("artifact-8119f590-0744-4fbc-b0ee-5ccf42cd5e84", "dataset-1hq3nnw", null, null, "London to Paris Â· 9â€“15 October 2026 Â· 1 passenger")
