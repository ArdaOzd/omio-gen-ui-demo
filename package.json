{
  "name": "omio-gen-ui-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "frontend:dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "frontend:preview": "vite preview --host 127.0.0.1",
    "seed": "python3 -m backend.generate_db --output data/omio.sqlite3 --rows 1000000",
    "start": "node scripts/run.mjs preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:leakage": "vitest run src/generative/contracts/privacy.test.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/react": "4.0.130",
    "@assistant-ui/ai-sdk": "0.0.9",
    "@assistant-ui/react": "0.15.23",
    "@assistant-ui/react-generative-ui": "0.0.22",
    "@openuidev/lang-core": "0.3.0",
    "@openuidev/react-lang": "0.3.0",
    "ai": "7.0.127",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@assistant-ui/vite": "0.0.19",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "26.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.3.1",
    "vitest": "4.1.11"
  }
