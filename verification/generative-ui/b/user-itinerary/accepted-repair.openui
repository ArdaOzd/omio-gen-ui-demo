$sort = {"field":"priceCents","direction":"asc"}
$selectedFareIds = []
firstComparison = Query("local_query", {"version":1,"sources":[{"datasetRef":"dataset-14rfd0v","alias":"fares"}],"where":{"all":[{"field":"originId","op":"eq","value":"barcelona"},{"field":"destinationId","op":"eq","value":"prague"},{"field":"serviceDate","op":"eq","value":"2026-10-03"}]},"groupBy":["mode"],"metrics":[{"as":"minimum","op":"min","field":"priceCents"},{"as":"fastest","op":"min","field":"durationMinutes"},{"as":"count","op":"count"}],"limit":4})
secondComparison = Query("local_query", {"version":1,"sources":[{"datasetRef":"dataset-1opc18h","alias":"fares"}],"where":{"all":[{"field":"originId","op":"eq","value":"prague"},{"field":"destinationId","op":"eq","value":"paris"},{"field":"serviceDate","op":"eq","value":"2026-10-05"}]},"groupBy":["mode"],"metrics":[{"as":"minimum","op":"min","field":"priceCents"},{"as":"fastest","op":"min","field":"durationMinutes"},{"as":"count","op":"count"}],"limit":4})
thirdComparison = Query("local_query", {"version":1,"sources":[{"datasetRef":"dataset-10j0qr8","alias":"fares"}],"where":{"all":[{"field":"originId","op":"eq","value":"paris"},{"field":"destinationId","op":"eq","value":"prague"},{"field":"serviceDate","op":"eq","value":"2026-10-10"}]},"groupBy":["mode"],"metrics":[{"as":"minimum","op":"min","field":"priceCents"},{"as":"fastest","op":"min","field":"durationMinutes"},{"as":"count","op":"count"}],"limit":4})
firstFares = Query("local_query", {"version":1,"sources":[{"datasetRef":"dataset-14rfd0v","alias":"fares"}],"where":{"all":[{"field":"originId","op":"eq","value":"barcelona"},{"field":"destinationId","op":"eq","value":"prague"},{"field":"serviceDate","op":"eq","value":"2026-10-03"}]},"project":["id","originId","destinationId","serviceDate","mode","carrierId","priceCents","durationMinutes","departureMinutes","availableSeats","currency","synthetic","priceBasis","direct"],"orderBy":[{"field":$sort.field,"direction":$sort.direction}],"limit":100})
sequence = CitySequence("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", null, null, null, "Barcelona → Prague → Paris → Prague")
route = RouteMap("artifact-393d7d99-1239-4aec-a13b-ddf28875374e")
hero = TravelHero("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", null, null, null, "Train versus bus · October 3–10, 2026", null, [sequence, route])
notice = CoverageNotice("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", null, null, null, "Loaded demo data contains no bus fares. Both Prague–Paris and Paris–Prague resources are empty; this does not establish real-world availability.")
matrixOne = ComparisonMatrix("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", "dataset-14rfd0v", null, null, "Price, duration and fare count by mode", null, null, null, null, firstComparison)
matrixTwo = ComparisonMatrix("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", "dataset-1opc18h", null, null, "Price, duration and fare count by mode", null, null, null, null, secondComparison)
matrixThree = ComparisonMatrix("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", "dataset-10j0qr8", null, null, "Price, duration and fare count by mode", null, null, null, null, thirdComparison)
emptyTwo = EmptyState("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", "dataset-1opc18h", null, null, "No train or bus fares in the loaded demo resource")
emptyThree = EmptyState("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", "dataset-10j0qr8", null, null, "No train or bus fares in the loaded demo resource")
legOne = Section("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", "dataset-14rfd0v", null, null, "October 3 · Barcelona → Prague", null, [matrixOne])
legTwo = Section("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", "dataset-1opc18h", null, null, "October 5 · Prague → Paris · after 2 nights", null, [matrixTwo, emptyTwo])
legThree = Section("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", "dataset-10j0qr8", null, null, "October 10 · Paris → Prague · after 5 nights", null, [matrixThree, emptyThree])
comparison = ResponsiveGrid("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", null, null, null, "Compare the three legs", null, [legOne, legTwo, legThree])
sorting = SortSelect("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", null, null, null, "Sort available fares", null, null, $sort, "sort")
plot = DurationPricePlot("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", "dataset-14rfd0v", null, null, "Barcelona → Prague · price versus duration", null, null, null, null, firstFares)
picker = FarePicker("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", "dataset-14rfd0v", null, null, "Choose a Barcelona → Prague fare", null, null, $selectedFareIds, "selectedFareIds", firstFares)
choices = Section("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", "dataset-14rfd0v", null, null, "Explore available demo fares", null, [sorting, plot, picker])
selected = SelectedItinerary("artifact-393d7d99-1239-4aec-a13b-ddf28875374e", null, null, null, "Selected fares · not a complete trip quotation")
